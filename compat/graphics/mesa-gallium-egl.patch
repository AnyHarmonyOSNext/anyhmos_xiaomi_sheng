diff --git a/src/egl/drivers/dri2/ohos_native_image_layout.h b/src/egl/drivers/dri2/ohos_native_image_layout.h
new file mode 100644
--- /dev/null
+++ b/src/egl/drivers/dri2/ohos_native_image_layout.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef OHOS_NATIVE_IMAGE_LAYOUT_H
+#define OHOS_NATIVE_IMAGE_LAYOUT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include "buffer_handle.h"
+#include <native_buffer/native_buffer.h>
+#include "drm-uapi/drm_fourcc.h"
+
+/* 固定当前平台的原生句柄字段布局 */
+_Static_assert(sizeof(BufferHandle) == 56, "native buffer handle size");
+_Static_assert(offsetof(BufferHandle, reserveFds) == 48, "native buffer fd offset");
+
+struct ohos_native_image_plane {
+   uint32_t offset;
+   uint32_t pitch;
+};
+
+struct ohos_native_image_layout {
+   uint32_t fourcc;
+   unsigned plane_count;
+   struct ohos_native_image_plane planes[3];
+};
+
+/* 按原生像素格式生成线性平面布局 */
+static inline bool
+ohos_native_image_layout(const BufferHandle *handle,
+                         struct ohos_native_image_layout *layout)
+{
+   const uint64_t allowed_usage = 3 | (1ULL << 3) | (1ULL << 4) |
+      (1ULL << 5) | (1ULL << 6) | (1ULL << 7) | (1ULL << 8) |
+      (1ULL << 9) | (1ULL << 10) | (1ULL << 16) |
+      (1ULL << 26) | (1ULL << 27);
+   unsigned bytes = 4;
+   bool yuv = false;
+   bool planar = false;
+   uint32_t fourcc;
+
+   /* 拒绝受保护或未知扩展布局 */
+   if (!handle || !layout || handle->fd < 0 || handle->reserveFds ||
+       handle->reserveInts || handle->width <= 0 || handle->height <= 0 ||
+       handle->width > 16384 || handle->height > 16384 ||
+       handle->stride <= 0 || handle->size <= 0 ||
+       handle->size > 256 * 1024 * 1024 ||
+       (handle->usage & ~allowed_usage))
+      return false;
+
+   switch (handle->format) {
+   case NATIVEBUFFER_PIXEL_FMT_RGB_565:
+      fourcc = DRM_FORMAT_RGB565;
+      bytes = 2;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_RGBX_8888:
+      fourcc = DRM_FORMAT_XBGR8888;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_RGBA_8888:
+      fourcc = DRM_FORMAT_ABGR8888;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_BGRX_8888:
+      fourcc = DRM_FORMAT_XRGB8888;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_BGRA_8888:
+      fourcc = DRM_FORMAT_ARGB8888;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_YCBCR_420_SP:
+      fourcc = DRM_FORMAT_NV12;
+      yuv = true;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_YCRCB_420_SP:
+      fourcc = DRM_FORMAT_NV21;
+      yuv = true;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_YCBCR_420_P:
+      fourcc = DRM_FORMAT_YUV420;
+      yuv = planar = true;
+      break;
+   case NATIVEBUFFER_PIXEL_FMT_YCRCB_420_P:
+      fourcc = DRM_FORMAT_YVU420;
+      yuv = planar = true;
+      break;
+   default:
+      return false;
+   }
+
+   if (yuv) {
+      bytes = 1;
+      if ((handle->width | handle->height | handle->stride) & 1)
+         return false;
+   }
+   if ((uint64_t)handle->stride < (uint64_t)handle->width * bytes ||
+       (handle->stride & 63))
+      return false;
+
+   const uint64_t luma = (uint64_t)handle->stride * handle->height;
+   const uint32_t rows = yuv ? (uint32_t)handle->height :
+      ((uint32_t)handle->height + 3) & ~3U;
+   const uint64_t required = yuv ? luma + luma / 2 :
+      (uint64_t)handle->stride * rows;
+   if (required > (uint64_t)handle->size)
+      return false;
+
+   struct ohos_native_image_layout result = {
+      .fourcc = fourcc,
+      .plane_count = yuv ? (planar ? 3 : 2) : 1,
+      .planes = {{0, handle->stride}},
+   };
+   if (yuv) {
+      /* 保留半平面和三平面的原始通道顺序 */
+      result.planes[1].offset = luma;
+      result.planes[1].pitch = planar ? handle->stride / 2 : handle->stride;
+      if (planar) {
+         result.planes[2].offset = luma + luma / 4;
+         result.planes[2].pitch = handle->stride / 2;
+      }
+   }
+   *layout = result;
+   return true;
+}
+
+#endif
