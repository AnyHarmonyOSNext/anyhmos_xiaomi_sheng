+                     const char *tag, const char *format, ...);
+
+/* 私有包装保存尺寸交接状态，不改变公共结构 */
+struct ohos_egl_surface {
+   struct dri2_egl_surface dri2;
+   bool resize_pending;
+   int old_width;
+   int old_height;
+   int target_width;
+   int target_height;
+};
+
+_Static_assert(offsetof(struct ohos_egl_surface, dri2) == 0,
+               "private surface base must be first");
+
+static unsigned int ohos_geometry_records;
+
+static bool
+ohos_new_geometry(struct ohos_egl_surface *surf, int width, int height)
+{
+   if (surf->resize_pending) {
+      return !(width == surf->old_width && height == surf->old_height) &&
+             !(width == surf->target_width && height == surf->target_height);
+   }
+   return width != surf->dri2.base.Width || height != surf->dri2.base.Height;
+}
+
+/* 保留新的目标尺寸，等待正常交换完成交接 */
+static void
+ohos_set_pending_geometry(struct ohos_egl_surface *surf, int width, int height,
+                          int old_width, int old_height)
+{
+   surf->old_width = old_width;
+   surf->old_height = old_height;
+   surf->target_width = width;
+   surf->target_height = height;
+   surf->resize_pending = true;
+   surf->dri2.base.Width = width;
+   surf->dri2.base.Height = height;
+   dri_invalidate_drawable(surf->dri2.dri_drawable);
+}
+
+/* 限量记录几何时序，不改变窗口状态 */
+static void
+ohos_trace_geometry(const char *event, struct dri2_egl_surface *surf,
+                    void *window, int result, int native_width,
+                    int native_height, int old_width, int old_height)
+{
+   const int saved_errno = errno;
+   unsigned int sequence = __atomic_load_n(&ohos_geometry_records,
+                                           __ATOMIC_RELAXED);
+
+   while (sequence < 32 &&
+          !__atomic_compare_exchange_n(&ohos_geometry_records, &sequence,
+                                       sequence + 1, false,
+                                       __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+   }
+   if (sequence < 32) {
+      struct timespec now = {0};
+      const int clock_result = clock_gettime(CLOCK_MONOTONIC, &now);
+
+      HiLogPrint(0, 4, 0xFF01, "ShengGeometry",
+                 "OHOS_GEOMETRY_R1 seq=%{public}u event=%{public}s "
+                 "pid=%{public}d clockrc=%{public}d sec=%{public}lld "
+                 "nsec=%{public}ld window=%{public}p drawable=%{public}p "
+                 "rc=%{public}d native=%{public}dx%{public}d "
+                 "old=%{public}dx%{public}d cache=%{public}dx%{public}d",
+                 sequence, event, (int)getpid(), clock_result,
+                 (long long)now.tv_sec, now.tv_nsec, window,
+                 (void *)surf->dri_drawable, result, native_width, native_height,
+                 old_width, old_height, surf->base.Width, surf->base.Height);
+   }
+   errno = saved_errno;
+}
 
