diff --git a/src/util/ohos_dmabuf_sync.h b/src/util/ohos_dmabuf_sync.h
new file mode 100644
--- /dev/null
+++ b/src/util/ohos_dmabuf_sync.h
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef OHOS_DMABUF_SYNC_H
+#define OHOS_DMABUF_SYNC_H
+
+#include "drm-uapi/dma-buf.h"
+#include "sheng_dmabuf_sync.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#ifdef __cplusplus
+static_assert(sizeof(struct sheng_dmabuf_sync_abi) == 16, "sync ABI size");
+static_assert(sizeof(struct sheng_dmabuf_sync_file) == 16, "sync file size");
+static_assert(offsetof(struct sheng_dmabuf_sync_file, fence_fd) == 8,
+              "sync fence offset");
+#else
+_Static_assert(sizeof(struct sheng_dmabuf_sync_abi) == 16, "sync ABI size");
+_Static_assert(sizeof(struct sheng_dmabuf_sync_file) == 16, "sync file size");
+_Static_assert(offsetof(struct sheng_dmabuf_sync_file, fence_fd) == 8,
+               "sync fence offset");
+#endif
+
+/* 重试可中断的同步接口，限制连续重试次数 */
+static inline int
+ohos_dmabuf_sync_ioctl(int fd, unsigned long request, void *value)
+{
+   int result;
+   unsigned retries = 0;
+   do {
+      result = ioctl(fd, request, value);
+   } while (result < 0 && (errno == EINTR || errno == EAGAIN) && ++retries < 32);
+   return result;
+}
+
+/* 只打开版本及双向同步能力均匹配的兼容设备 */
+static inline int
+ohos_dmabuf_sync_open(void)
+{
+   struct sheng_dmabuf_sync_abi abi = {0};
+   int fd = open(SHENG_DMABUF_SYNC_DEVICE, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return -1;
+   int result = ohos_dmabuf_sync_ioctl(fd, SHENG_DMABUF_SYNC_QUERY, &abi);
+   if (result || abi.version != SHENG_DMABUF_SYNC_VERSION || abi.reserved ||
+       (abi.features & SHENG_DMABUF_SYNC_FEATURES_REQUIRED) !=
+           SHENG_DMABUF_SYNC_FEATURES_REQUIRED) {
+      int error = result ? errno : EPROTO;
+      close(fd);
+      errno = error;
+      return -1;
+   }
+   return fd;
+}
+
+static inline bool
+ohos_dmabuf_sync_available(void)
+{
+   int fd = ohos_dmabuf_sync_open();
+   return fd >= 0 && close(fd) == 0;
+}
+
+/* 验证新导出的描述符，失败时只回收本次所有权 */
+static inline int
+ohos_dmabuf_sync_check_export(int fd, int dma_buf_fd, int helper_fd, int *fence_fd)
+{
+   if (fd < 0 || fd == dma_buf_fd || fd == helper_fd) {
+      errno = EPROTO;
+      return -1;
+   }
+   int flags = fcntl(fd, F_GETFD);
+   if (flags < 0 || !(flags & FD_CLOEXEC)) {
+      int error = flags < 0 ? errno : EPROTO;
+      close(fd);
+      errno = error;
+      return -1;
+   }
+   *fence_fd = fd;
+   return 0;
+}
+
+/* 标准接口仅在不支持时转入兼容设备 */
+static inline int
+ohos_dmabuf_sync_export(int dma_buf_fd, uint32_t flags, int *fence_fd)
+{
+   if (fence_fd)
+      *fence_fd = -1;
+   if (!fence_fd || dma_buf_fd < 0 || !flags ||
+       (flags & ~SHENG_DMABUF_SYNC_VALID_FLAGS)) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct dma_buf_export_sync_file standard = {.flags = flags, .fd = -1};
+   if (!ohos_dmabuf_sync_ioctl(dma_buf_fd, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &standard))
+      return ohos_dmabuf_sync_check_export(standard.fd, dma_buf_fd, -1, fence_fd);
+   int error = errno;
+   /* 接口失败不转移描述符，输出槽不具有所有权 */
+   if (error != ENOTTY) {
+      errno = error;
+      return -1;
+   }
+
+   int helper = ohos_dmabuf_sync_open();
+   if (helper < 0)
+      return -1;
+   struct sheng_dmabuf_sync_file transfer = {
+       .dma_buf_fd = dma_buf_fd,
+       .flags = flags,
+       .fence_fd = -1,
+   };
+   int result = ohos_dmabuf_sync_ioctl(helper, SHENG_DMABUF_SYNC_EXPORT, &transfer);
+   error = errno;
+   if (!result) {
+      result =
+          ohos_dmabuf_sync_check_export(transfer.fence_fd, dma_buf_fd, helper, fence_fd);
+      error = errno;
+   }
+   if (close(helper) && !result) {
+      error = errno;
+      close(*fence_fd);
+      *fence_fd = -1;
+      result = -1;
+   }
+   if (result)
+      errno = error;
+   return result;
+}
+
+/* 导入只借用缓冲区和同步文件，不关闭调用者描述符 */
+static inline int
+ohos_dmabuf_sync_import(int dma_buf_fd, uint32_t flags, int fence_fd)
+{
+   if (dma_buf_fd < 0 || fence_fd < 0 || !flags ||
+       (flags & ~SHENG_DMABUF_SYNC_VALID_FLAGS)) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct dma_buf_import_sync_file standard = {.flags = flags, .fd = fence_fd};
+   if (!ohos_dmabuf_sync_ioctl(dma_buf_fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &standard))
+      return 0;
+   if (errno != ENOTTY)
+      return -1;
+
+   int helper = ohos_dmabuf_sync_open();
+   if (helper < 0)
+      return -1;
+   struct sheng_dmabuf_sync_file transfer = {
+       .dma_buf_fd = dma_buf_fd,
+       .flags = flags,
+       .fence_fd = fence_fd,
+   };
+   int result = ohos_dmabuf_sync_ioctl(helper, SHENG_DMABUF_SYNC_IMPORT, &transfer);
+   int error = errno;
+   if (close(helper) && !result) {
+      error = errno;
+      result = -1;
+   }
+   if (result)
+      errno = error;
+   return result;
+}
+
+#endif
