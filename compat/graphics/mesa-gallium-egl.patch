+/* 仅获取仍存活的缓存引用，禁止从零引用复活 */
+static bool
+surface_try_reference(struct zink_surface *surface)
+{
+   int count = p_atomic_read(&surface->base.reference.count);
+   while (count > 0) {
+      int observed = p_atomic_cmpxchg(&surface->base.reference.count, count, count + 1);
+      if (observed == count)
+         return true;
+      count = observed;
+   }
+   return false;
