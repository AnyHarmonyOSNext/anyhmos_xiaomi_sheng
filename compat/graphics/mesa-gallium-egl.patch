+/* 将原生缓冲映射为保留通道顺序的共享图像 */
+static _EGLImage *
+ohos_create_image(_EGLDisplay *disp, _EGLContext *ctx, EGLenum target,
+                  EGLClientBuffer buffer, const EGLint *attrib_list)
+{
+   static const EGLint plane_attributes[3][5] = {
+      {EGL_DMA_BUF_PLANE0_FD_EXT, EGL_DMA_BUF_PLANE0_OFFSET_EXT,
+       EGL_DMA_BUF_PLANE0_PITCH_EXT, EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT,
+       EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT},
+      {EGL_DMA_BUF_PLANE1_FD_EXT, EGL_DMA_BUF_PLANE1_OFFSET_EXT,
+       EGL_DMA_BUF_PLANE1_PITCH_EXT, EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT,
+       EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT},
+      {EGL_DMA_BUF_PLANE2_FD_EXT, EGL_DMA_BUF_PLANE2_OFFSET_EXT,
+       EGL_DMA_BUF_PLANE2_PITCH_EXT, EGL_DMA_BUF_PLANE2_MODIFIER_LO_EXT,
+       EGL_DMA_BUF_PLANE2_MODIFIER_HI_EXT},
+   };
+   EGLint attributes[56];
+   unsigned count = 0;
+   struct ohos_native_image_layout layout;
+   struct stat storage;
+   OHNativeWindowBuffer *native = buffer;
+   BufferHandle *handle;
+
+   if (target != EGL_NATIVE_BUFFER_OHOS)
+      return dri2_create_image_khr(disp, ctx, target, buffer, attrib_list);
+
+   if (ctx || !native) {
+      _eglError(EGL_BAD_PARAMETER, "ohos_create_image: invalid native context");
+      return NULL;
+   }
+   if (!dri2_egl_display(disp)->has_dmabuf_import) {
+      _eglError(EGL_BAD_MATCH, "ohos_create_image: dma-buf import unavailable");
+      return NULL;
+   }
+
+   /* 通过原厂接口解包真实载体 */
+   handle = OH_NativeWindow_GetBufferHandleFromNative(native);
+   if (!ohos_native_image_layout(handle, &layout) ||
+       fstat(handle->fd, &storage) || storage.st_size < handle->size) {
+      _eglError(EGL_BAD_PARAMETER, "ohos_create_image: invalid linear layout");
+      return NULL;
+   }
+
+   if (attrib_list) {
+      unsigned i;
+      for (i = 0; i < 16 && attrib_list[i] != EGL_NONE; i += 2) {
+         switch (attrib_list[i]) {
+         case EGL_IMAGE_PRESERVED_KHR:
+         case EGL_YUV_COLOR_SPACE_HINT_EXT:
+         case EGL_SAMPLE_RANGE_HINT_EXT:
+         case EGL_YUV_CHROMA_HORIZONTAL_SITING_HINT_EXT:
+         case EGL_YUV_CHROMA_VERTICAL_SITING_HINT_EXT:
+            attributes[count++] = attrib_list[i];
+            attributes[count++] = attrib_list[i + 1];
+            break;
