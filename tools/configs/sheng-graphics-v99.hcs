/* SPDX-License-Identifier: MIT
 * Two-host sheng trial, no donor board hardware enumeration.
 * IDs follow hdf_attribute.c enumeration order: allocator=0, composer=1.
 */
root {
    module = "hdf";
    device_info {
        match_attr = "hdf_manager";
        allocator {
            hostName = "allocator_host";
            priority = 50;
            allocator_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "liballocator_driver_1.0.z.so";
                    serviceName = "allocator_service";
                    preload = 0;
                    permission = 0664;
                    deviceMatchAttr = "";
                }
            }
        }
        display_composer {
            hostName = "composer_host";
            priority = 50;
            composer_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "libdisplay_composer_driver_1.0.z.so";
                    serviceName = "display_composer_service";
                    preload = 0;
                    permission = 0664;
                    deviceMatchAttr = "";
                }
            }
        }
        sheng_userauth {
            hostName = "sheng_userauth_host";
            priority = 50;
            userauth_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "/compat/lib64/libsheng_user_auth_driver.so";
                    serviceName = "user_auth_interface_service";
                    preload = 0;
                    permission = 0664;
                    deviceMatchAttr = "";
                }
            }
        }
        sheng_wifi {
            hostName = "wifi_host";
            priority = 50;
            wifi_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "libwifi_hdi_c_device.z.so";
                    serviceName = "wlan_interface_service";
                    preload = 1;
                    permission = 0664;
                    deviceMatchAttr = "";
                }
            }
        }
        sheng_wpa {
            hostName = "wpa_host";
            priority = 50;
            wpa_device {
                device0 {
                    policy = 2;
                    priority = 100;
                    moduleName = "libwpa_hdi_c_device.z.so";
                    serviceName = "wpa_interface_service";
                    preload = 1;
                    permission = 0664;
                    deviceMatchAttr = "";
                }
            }
        }
    }
}
